# AurApp Backend Environment Configuration
PORT=3000
NODE_ENV=development

# Groq AI Settings
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# JWT Authentication
JWT_SECRET=your_jwt_secret_here

# Supabase Configurations
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=uploads

# Firebase Configurations (Admin SDK)
FIREBASE_DATABASE_URL=https://your-app.firebaseio.com
FIREBASE_STORAGE_BUCKET=your-app.appspot.com
# Use serviceAccountKey.json file in root backend folder or set FIREBASE_SERVICE_ACCOUNT_JSON env var
FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type": "service_account", ...}

# Firebase Client API Key (for auth verify token / password flows)
FIREBASE_WEB_API_KEY=your_firebase_web_api_key
